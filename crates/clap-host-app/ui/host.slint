// clap-host-rs shell — param sliders, computer-keyboard notes, a button for
// the plugin's own (floating) window, and a Setup dialog for device pickers.
// Ported from the aura-host shell; theme/widgets re-hosted locally.

import { HostTheme } from "theme.slint";
import { ParamSlider } from "widgets.slint";
import { SetupDialog } from "setup.slint";
import { Button, LineEdit, ScrollView } from "std-widgets.slint";

// The dialog is its own window, compiled in via the import above; re-export
// so the generated Rust exposes both window types from this one compile unit.
export { SetupDialog }

export struct ParamRow {
    id: int,
    name: string,
    value: float,
    minimum: float,
    maximum: float,
    text: string,
}

export component HostWindow inherits Window {
    title: "CLAP-Host-RS";
    preferred-width: 620px;
    preferred-height: 660px;
    min-width: 460px;
    min-height: 420px;
    background: HostTheme.surface;

    in property <string> plugin-name: "";
    in property <string> plugin-id: "";
    in property <string> audio-status: "";
    in property <string> midi-status: "";
    in property <bool> gui-available: false;
    in property <bool> gui-open: false;
    in property <[ParamRow]> params: [];
    in-out property <string> param-filter: "";
    in property <[string]> audio-devices: [];
    in property <[string]> audio-in-devices: [];
    in property <[string]> midi-ports: [];
    in property <bool> has-audio-in: false;
    in-out property <int> audio-index: 0;
    in-out property <int> audio-in-index: 0;
    in-out property <int> midi-index: 0;
    in-out property <int> octave: 4;
    in-out property <string> log-text: "";
    in property <bool> state-dirty: false;
    in property <bool> preset-load-available: false;
    in property <bool> remote-available: false;
    in property <string> remote-page-name: "";
    in property <int> remote-page: 0;
    in property <int> remote-page-count: 0;
    in property <[ParamRow]> remote-params: [];
    // Embedded plugin editor: gui.rs swaps the param page for this slot and
    // places the Win32 socket HWND at (editor-x, editor-y), physical px.
    in property <bool> editor-embedded: false;
    in property <length> editor-width: 0px;
    in property <length> editor-height: 0px;
    out property <length> editor-x;
    out property <length> editor-y;

    callback param-changed(int, float);
    callback remote-prev();
    callback remote-next();
    callback remote-param-changed(int, float);
    callback save-state();
    callback load-state();
    callback load-preset();
    callback audio-device-changed(int);
    callback audio-in-changed(int);
    callback midi-port-changed(int);
    callback open-setup();
    callback toggle-gui();
    callback note-on(int);
    callback note-off(int);

    // Two rows of the classic tracker layout, starting at C of `octave`.
    function key-semitone(k: string) -> int {
        return k == "a" ? 0 : k == "w" ? 1 : k == "s" ? 2 : k == "e" ? 3
            : k == "d" ? 4 : k == "f" ? 5 : k == "t" ? 6 : k == "g" ? 7
            : k == "z" ? 8 : k == "h" ? 9 : k == "u" ? 10 : k == "j" ? 11
            : k == "k" ? 12 : k == "o" ? 13 : k == "l" ? 14 : -1;
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.repeat) {
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.octave = min(root.octave + 1, 8);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.octave = max(root.octave - 1, 0);
                return accept;
            }
            if (root.key-semitone(event.text) >= 0) {
                root.note-on((root.octave + 1) * 12 + root.key-semitone(event.text));
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if (root.key-semitone(event.text) >= 0) {
                root.note-off((root.octave + 1) * 12 + root.key-semitone(event.text));
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 0px;
            spacing: 0px;

            Rectangle {
                height: 3px;
                background: HostTheme.primary;
            }

            // Top bar — stays visible while the plugin editor fills the rest.
            VerticalLayout {
                vertical-stretch: 0;
                padding: 16px;
                padding-bottom: 6px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: root.plugin-name;
                                color: HostTheme.primary;
                                font-size: 20px;
                                font-weight: 700;
                            }
                            Text {
                                text: "●";
                                color: HostTheme.primary;
                                font-size: 14px;
                                visible: root.state-dirty;
                                vertical-alignment: center;
                            }
                        }
                        Text {
                            text: root.plugin-id;
                            color: HostTheme.on-surface-variant;
                            font-size: 12px;
                        }
                    }
                    Button {
                        text: "Save State";
                        clicked => { root.save-state(); }
                    }
                    Button {
                        text: "Load State";
                        clicked => { root.load-state(); }
                    }
                    Button {
                        text: "Load Preset…";
                        enabled: root.preset-load-available;
                        clicked => { root.load-preset(); }
                    }
                    Button {
                        text: "Setup";
                        clicked => { root.open-setup(); }
                    }
                    Button {
                        text: root.gui-open ? "Close plugin GUI" : "Open plugin GUI";
                        enabled: root.gui-available;
                        clicked => { root.toggle-gui(); }
                    }
                }

                // Status only — pickers live in the Setup dialog.
                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: root.audio-status;
                        color: HostTheme.on-surface-variant;
                        font-size: 12px;
                    }
                    Text {
                        text: root.midi-status;
                        color: HostTheme.on-surface-variant;
                        font-size: 12px;
                        visible: root.midi-status != "";
                    }
                }
            }

            // Reserved client area for the embedded plugin HWND.
            editor-slot := Rectangle {
                visible: root.editor-embedded;
                vertical-stretch: 0;
                height: root.editor-embedded ? root.editor-height + 16px : 0px;
                background: HostTheme.surface-container;
                border-radius: HostTheme.radius-md;
                border-width: 1px;
                border-color: HostTheme.outline-variant;
            }

            // Absorbs rounding slack in embedded mode only — when the param
            // page is visible it must NOT eat the space the params want.
            Rectangle {
                visible: root.editor-embedded;
                vertical-stretch: 1;
            }

            // Param page — hidden while the plugin editor fills the window.
            // The wrapper claims the window's leftover height so the stretch
            // chain reaches the params ScrollView (stretch does not propagate
            // out of an `if` into the outer layout).
            param-page := Rectangle {
                visible: !root.editor-embedded;
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                Rectangle {
                    vertical-stretch: 1;
                    background: HostTheme.surface-container;
                    border-radius: HostTheme.radius-md;
                    border-width: 1px;
                    border-color: HostTheme.outline-variant;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;

                        Text {
                            text: root.params.length > 0 ? "Parameters" : "No parameters";
                            color: HostTheme.on-surface-variant;
                            font-size: HostTheme.font-label;
                        }

                        LineEdit {
                            text <=> root.param-filter;
                            placeholder-text: "Filter parameters…";
                            visible: root.params.length > 0;
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 6px;
                                for p[i] in root.params: ParamSlider {
                                    label: p.name;
                                    value: p.value;
                                    minimum: p.minimum;
                                    maximum: p.maximum;
                                    value-text: p.text;
                                    changed(v) => { root.param-changed(p.id, v); }
                                }
                            }
                        }
                    }
                }

                // Remote controls: the plugin's own "most important params" pages.
                if root.remote-available: Rectangle {
                    background: HostTheme.surface-container;
                    border-radius: HostTheme.radius-md;
                    border-width: 1px;
                    border-color: HostTheme.outline-variant;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: root.remote-page-name + "  (" + (root.remote-page + 1) + "/" + root.remote-page-count + ")";
                                color: HostTheme.on-surface-variant;
                                font-size: HostTheme.font-label;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: "‹";
                                enabled: root.remote-page > 0;
                                clicked => { root.remote-prev(); }
                            }
                            Button {
                                text: "›";
                                enabled: root.remote-page + 1 < root.remote-page-count;
                                clicked => { root.remote-next(); }
                            }
                        }

                        for p[i] in root.remote-params: ParamSlider {
                            label: p.name;
                            value: p.value;
                            minimum: p.minimum;
                            maximum: p.maximum;
                            value-text: p.text;
                            changed(v) => { root.remote-param-changed(p.id, v); }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        horizontal-stretch: 1;
                        text: "Keys a-l / w-o play notes · ↑↓ octave \{root.octave}"
                            + (keys.has-focus ? "" : " · click Focus keys first");
                        color: HostTheme.on-surface-variant;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Button {
                        text: "Focus keys";
                        clicked => { keys.focus(); }
                    }
                }

                Text {
                    text: root.log-text;
                    color: HostTheme.on-surface-variant;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                }
            }
        }
    }

    // Where gui.rs places the embedded plugin's HWND (physical px after the
    // scale-factor conversion there): 8px inside the reserved slot.
    editor-x: editor-slot.x + 8px;
    editor-y: editor-slot.y + 8px;
}
